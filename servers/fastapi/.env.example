# Database Configuration
DATABASE_URL=postgresql+asyncpg://username:password@your-cloud-host:5432/your_database

# Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
# Not needed in backend - token verification is done via Google's tokeninfo endpoint

# Other existing configurations...
APP_DATA_DIRECTORY=C:/Users/kumar/.medhavi
TEMP_DIRECTORY=C:/Users/kumar/.medhavi/temp
# Manim MCP Server Configuration (optional - defaults work for Azure production)
# MANIM_SERVER_PATH=/opt/manim-mcp-server/src/manim_server.py
# MANIM_EXECUTABLE=/usr/local/bin/manim
# MANIM_MEDIA_DIR=/opt/manim-mcp-server/src/media
# For Windows development, uncomment and set:
# MANIM_SERVER_PATH=C:/path/to/manim-mcp-server/src/manim_server.py
# MANIM_EXECUTABLE=C:/path/to/manim.exe
# MANIM_MEDIA_DIR=C:/path/to/manim-mcp-server/src/media